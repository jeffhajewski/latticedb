// Isolation without versions: the writer stages its changes in its overlay;
// at commit, before anything is applied, the pre-image of each entity it
// changes is copied into every open reader's overlay that lacks one.
digraph txn_overlays {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.5
  ranksep=0.45
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Menlo,Consolas,monospace" fontsize=11
        fontcolor="#1a1a1a" margin="0.2,0.12"]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7
        fontname="Helvetica,Arial,sans-serif" fontsize=10 fontcolor="#6b7280"]

  writer [label="Writer overlay\lnode 7: name = \"B\"\l" fillcolor="#eaf5ea" color="#2f7d32"]
  reader [label="Reader overlay\lnode 7: name = \"A\"  (pre-image)\l"]
  trees  [label="Committed trees\lnode 7: name = \"A\", then \"B\"\l" fillcolor="#dbe9f8"]
  log    [label="Log\lrecords + TXN_COMMIT\l" fillcolor="#f6f8fa" color="#c7d0da"]

  trees -> reader [label="  1. copy pre-image" color="#4a90d9"]
  writer -> log [label="  2. log, sync"]
  writer -> trees [label="  3. apply" color="#2f7d32"]

  { rank=same; writer; reader }
}
