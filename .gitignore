# Release build artifacts (keep dist/*.sh scripts tracked)
dist/build/
dist/release/

# A bug that makes the engine treat ":memory:" as an ordinary path creates real
# files with this name. Ignoring them keeps one from being committed by accident
# while somebody is chasing that bug.
:memory:
:memory:-wal
.zig-cache-global/
.zig-global-cache/

# Agent harness: coordination state and the generated board are machine-local.
# The harness code and config in .claude/harness are tracked.
.claude/state/
.claude/PROGRESS.md
.claude/settings.local.json
