// Tokenization: split into words by Unicode class, filter by length, drop
// stop words (compared folded), then normalise each word into a term.
digraph fts_tokenize {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.3
  ranksep=0.36
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Menlo,Consolas,monospace" fontsize=11
        fontcolor="#1a1a1a" margin="0.22,0.13"]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7]

  in [label="\"Hello, World! This is a TEST.\"" fillcolor="#f6f8fa" color="#c7d0da"]
  s1 [label="1. Split into words: runs of letters, digits\l   and marks in any script (Han and hiragana:\l   one character per word)\l   Hello  World  This  is  a  TEST\l"]
  s2 [label="2. Length filter (2…64 bytes)\l   Hello  World  This  is  TEST\l   (\"a\" dropped)\l"]
  s3 [label="3. Drop stop words (compared folded)\l   Hello  World  TEST\l   (\"this\", \"is\" dropped)\l"]
  s4 [label="4. Normalise: lowercase, fold accents,\l   stem if enabled (café → cafe)\l   hello  world  test\l"]
  out [label="Token{\"hello\", pos 0}\lToken{\"world\", pos 1}\lToken{\"test\",  pos 2}\l"
       fillcolor="#eaf5ea" color="#2f7d32"]

  in -> s1 -> s2 -> s3 -> s4 -> out
}
