// A Cypher string becomes result rows. A query-cache hit skips lexing, parsing
// and analysis, and a prepared query skips the cache lookup as well; a write
// query with no caller transaction runs inside an automatic read-write
// transaction. Plans are not cached: every execution plans again.
digraph query_pipeline {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.3
  ranksep=0.34
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Helvetica,Arial,sans-serif" fontsize=12
        fontcolor="#1a1a1a" margin="0.24,0.13" width=2.0]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7
        fontname="Helvetica,Arial,sans-serif" fontsize=10 fontcolor="#6b7280"]

  q [label="MATCH (p:Person) WHERE p.age > 30\nRETURN p.name LIMIT 10"
     fillcolor="#f6f8fa" color="#c7d0da"
     fontname="Menlo,Consolas,monospace" fontsize=11]

  cache    [label="Query cache\n(normalized text → AST + bindings)" fillcolor="#f6f8fa" color="#c7d0da"]
  prepared [label="Prepared query\n(holds its cache entry)" fillcolor="#f6f8fa" color="#c7d0da"
            style="filled,rounded,dashed"]
  lexer    [label="Lexer"]
  parser   [label="Parser"]
  semantic [label="Semantic Analyzer"]
  planner  [label="Planner"]
  txn      [label="Auto transaction\n(write query, no caller txn)"
            fillcolor="#f6f8fa" color="#c7d0da" style="filled,rounded,dashed"]
  executor [label="Executor" fillcolor="#dbe9f8"]

  q        -> cache
  cache    -> lexer    [label="  miss"]
  lexer    -> parser   [label="  tokens"]
  parser   -> semantic [label="  AST"]
  semantic -> planner  [label="  validated AST\n  (stored in the cache)"]
  cache    -> planner  [label="  hit" style=dashed]
  prepared -> planner  [label="  no lookup" style=dashed]
  planner  -> txn      [label="  operator tree"]
  txn      -> executor [label="  begin read-write"]

  rows [label="Result rows" fillcolor="#eaf5ea" color="#2f7d32"]
  executor -> rows [color="#2f7d32" label="  then commit (abort on error)"]
}
