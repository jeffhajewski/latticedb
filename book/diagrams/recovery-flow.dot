// Startup recovery: only a read-write open with the WAL enabled recovers.
// Analysis builds the redo list; redo re-executes committed operations
// through the stores; anything redone is rebuilt and synced before open returns.
digraph recovery_flow {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.3
  ranksep=0.4
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Helvetica,Arial,sans-serif" fontsize=12
        fontcolor="#1a1a1a" margin="0.24,0.14" width=3.8]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7
        fontname="Helvetica,Arial,sans-serif" fontsize=10 fontcolor="#6b7280"]

  start [label="Database.open" fillcolor="#f6f8fa" color="#c7d0da"]
  gate  [shape=diamond style="filled" fillcolor="#f6f8fa" color="#c7d0da" width=2.2
         label="read-write and\nWAL enabled?" fontsize=11 margin="0.05,0.05"]
  skip  [label="Stores load as usual;\nno WAL, no recovery, no transactions;\nsees only what is in the file" fillcolor="#f6f8fa" color="#c7d0da"]
  open  [label="Open WAL file\ncheck UUID, find end of log\nread checkpoint_lsn"]
  stores [label="Load B+Trees, graph stores,\nFTS and vector index"]
  analysis [label="Analysis phase\l  track transaction states\l  build the redo list\l  stop at corruption or end of log\l"
            fillcolor="#dbe9f8" fontname="Menlo,Consolas,monospace" fontsize=11]
  redo [label="Redo phase (logical)\l  committed → re-execute through\l    graph, stream and vector stores\l  otherwise → discard\l"
        fillcolor="#dbe9f8" fontname="Menlo,Consolas,monospace" fontsize=11]
  rebuild [label="If anything was redone:\lrebuild property and FTS indexes\lsync: vector index, tree roots,\l  flush buffer pool, fsync file\l"
           fontname="Menlo,Consolas,monospace" fontsize=11]
  tm    [label="Start transaction manager"]
  ready [label="Database ready for use" fillcolor="#eaf5ea" color="#2f7d32" penwidth=1.5]

  start -> gate
  gate -> skip [label="  no"]
  gate -> open [label="  yes"]
  open -> stores -> analysis -> redo -> rebuild -> tm -> ready
  skip -> ready [style=dashed color="#c7d0da"]
}
