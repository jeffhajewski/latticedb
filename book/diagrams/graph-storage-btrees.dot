// The core graph is decomposed into six B+Trees, each tuned to one access
// pattern. They are components of the storage layer, not stages in a flow, so
// they are drawn as a container rather than a tree of edges.
digraph graph_storage_btrees {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.3
  ranksep=0.3
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Helvetica,Arial,sans-serif" fontsize=12
        fontcolor="#1a1a1a" margin="0.20,0.12" width=2.0]
  edge [style=invis]

  subgraph cluster_layer {
    label="Graph Storage Layer"
    labelloc=t
    fontname="Helvetica,Arial,sans-serif" fontsize=13 fontcolor="#1a1a1a"
    color="#4a90d9" penwidth=1.3 style=rounded bgcolor="#f7fafd" margin=16

    symbols  [label="SYMBOLS\nstring → id"]
    symrev   [label="SYMBOLS_REVERSE\nid → string"]
    nodes    [label="NODES\nnode_id → NodeData"]
    edges_t  [label="EDGES\ntraversal key → empty"]
    edge_ids [label="EDGE_ID\nedge_id → payload\n(key 0: next_edge_id)"]
    labels   [label="LABEL_INDEX\n(label, node) → empty"]

    { rank=same; symbols -> symrev -> nodes }
    { rank=same; edges_t -> edge_ids -> labels }
    symbols -> edges_t
    symrev  -> edge_ids
    nodes   -> labels
  }
}
