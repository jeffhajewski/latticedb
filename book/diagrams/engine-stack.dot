// The layered engine. The Database orchestrates; the transaction manager only
// writes log records, and the log writes its own file outside the buffer pool.
// Every flush of the pool is copied to the journal before the pages are
// written in place, so the database file moves from one whole image to the next.
digraph engine_stack {
  bgcolor="transparent"
  rankdir=TB
  nodesep=0.35
  ranksep=0.45
  fontname="Helvetica,Arial,sans-serif"
  node [shape=box style="filled,rounded" fillcolor="#eef4fb" color="#4a90d9"
        penwidth=1.2 fontname="Helvetica,Arial,sans-serif" fontsize=12
        fontcolor="#1a1a1a" margin="0.24,0.13" width=2.2]
  edge [color="#6b7280" penwidth=1.1 arrowsize=0.7]

  app  [label="Application" fillcolor="#f6f8fa" color="#c7d0da" width=6.4]
  db   [label="Database\ngraph · vector · FTS · streams · query\nper-transaction overlays, single writer"
        fillcolor="#dbe9f8" width=6.4]

  btree [label="B+Trees\nordered data"]
  txn   [label="Transaction Manager\nbegin / commit records"]
  ckpt  [label="Checkpointer\nflush pages, reset log"]

  wal  [label="WAL\nown -wal file"]
  pool [label="Buffer Pool\npage caching in RAM" width=4.6]
  pgm  [label="Page Manager\nallocation, checksums" width=2.6]
  jnl  [label="Journal\nown -journal file" width=1.8]
  vfs  [label="Virtual File System\nfile I/O" width=6.4]
  os   [label="Operating System" fillcolor="#f6f8fa" color="#c7d0da" width=6.4]

  app -> db
  db -> btree
  db -> txn
  db -> ckpt
  db -> pool [label="  vector and\l  posting pages\l" fontname="Helvetica,Arial,sans-serif"
              fontsize=10 fontcolor="#6b7280"]
  txn -> wal
  btree -> pool
  ckpt -> pool
  ckpt -> pgm
  ckpt -> wal
  pool -> pgm
  pool -> jnl
  pgm  -> vfs
  wal  -> vfs
  jnl  -> vfs
  vfs  -> os

  { rank=same; btree; txn; ckpt }
  { rank=same; pool; wal }
  { rank=same; pgm; jnl }
}
